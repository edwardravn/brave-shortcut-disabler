{
  "manifest_version": 3,
  "name": "Brave Shortcut Disabler",
  "version": "1.0.0",
  "description": "Blocks keyboard shortcuts and single-key page actions on websites.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Brave Shortcut Disabler",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
